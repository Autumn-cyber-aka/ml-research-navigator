# Copy to .env; generate all secrets with scripts/configure.py.
SECRET_KEY=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=navigator
MYSQL_PASSWORD=
MYSQL_DATABASE=navigator
MYSQL_ROOT_PASSWORD=
# Use 1 behind HTTPS. Local HTTP requires 0.
COOKIE_SECURE=0

# Public HTTPS hosting only: trust exactly one platform reverse proxy.
TRUST_PROXY=0
# Cloud MySQL CA file path; when set, certificate AND hostname are verified.
MYSQL_SSL_CA=
